    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the paired Mac on the same Wi-Fi and connects without VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じWi-Fiにあるペアリング済みのMacを探して、VPNなしで接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Wi-Fi에 있는 페어링한 Mac을 찾아 VPN 없이 연결합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找同一 Wi-Fi 下已配对的 Mac，无需 VPN 即可连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尋找同一個 Wi-Fi 上已配對的 Mac，不需 VPN 即可連線。"
          }
        }
      }
    },
