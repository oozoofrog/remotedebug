    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Announces this Mac so paired iPhones on the same network connect to it without VPN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じネットワークにあるペアリング済みのiPhoneが、VPNなしでこのMacに接続できるように通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크의 페어링한 iPhone이 VPN 없이 이 Mac에 연결하도록 알립니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知同一网络中已配对的 iPhone 无需 VPN 即可连接这台 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知同一網路上已配對的 iPhone，不需 VPN 即可連線到這部 Mac。"
          }
        }
      }
    },
    "프로젝트 폴더 또는 빌드" : {
