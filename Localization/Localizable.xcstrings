        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のペアリングリクエストは期限切れです。iPhoneからもう一度リクエストしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的配对请求已过期。请在 iPhone 上重新请求。"
