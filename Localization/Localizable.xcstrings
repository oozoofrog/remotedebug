    "%@(%@): 이 Mac의 빌드 목록과 설치에 접근할 수 없게 되고, 진행 중인 설치는 끊깁니다. 다시 쓰려면 새로 페어링해야 합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@): It will lose access to this Mac's build list and installs, and any installation in progress will be interrupted. You'll need to pair it again to use it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@): このMacのビルド一覧とインストールにアクセスできなくなり、進行中のインストールは中断されます。再び使うには、あらためてペアリングが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@(%2$@): 이 Mac의 빌드 목록과 설치에 접근할 수 없게 되고, 진행 중인 설치는 끊깁니다. 다시 쓰려면 새로 페어링해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）：将无法访问这台 Mac 的构建列表和安装，进行中的安装会中断。要再次使用，必须重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)：將無法存取這部 Mac 的建置列表與安裝，進行中的安裝也會中斷。若要再次使用，必須重新配對。"
          }
        }
      }
    },
    "%@. 만료되기 전에 기기 화면에서 허용하거나 거부하세요." : {
      "localizations" : {
