          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除存储在这台 iPhone 上的 Tailscale 登录信息并重新打开 VPN。出现登录页面时，请选择与 Mac 相同的账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會清除儲存在此 iPhone 上的 Tailscale 登入，並重新開啟 VPN。出現登入頁面時，請選擇與 Mac 相同的帳號。"
          }
        }
      }
    },
    "이 iPhone에만 있는 파일" : {
      "localizations" : {
        "en" : {
