      }
    },
    "저장 폴더를 잠그지 못했습니다: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't lock the save folder: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存フォルダをロックできませんでした: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法锁定存储文件夹：%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法鎖定儲存檔案夾：%@"
          }
        }
      }
    },
    "저장 폴더를 준비하지 못했습니다: %@ 게시한 빌드는 그대로 두었습니다. 폴더 권한을 확인한 뒤 공유를 시작하거나 빌드를 다시 가져오세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't prepare the save folder: %@ The published builds were left as they are. Check the folder permissions, then start sharing or import the build again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存フォルダを準備できませんでした: %@ 公開したビルドはそのまま残しています。フォルダの権限を確認してから共有を開始するか、ビルドをもう一度インポートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法准备存储文件夹：%@ 已发布的构建保持不变。请检查文件夹权限后开始共享，或重新导入构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法準備儲存檔案夾：%@ 已發布的建置維持原樣。請確認檔案夾權限後開始共享，或重新匯入建置。"
          }
        }
      }
    },
    "저장된 기기 %@대는 다른 제어 서버(%@)에서 페어링해 지금 서버에서는 허용하지 않습니다. 기기 목록을 지우고 새로 페어링하거나, 제어 서버를 원래대로 되돌리세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ saved devices were paired on a different control server (%2$@) and aren't allowed on the current server. Clear the device list and pair again, or switch the control server back."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているデバイス %1$@ 台は別のコントロールサーバ(%2$@)でペアリングされたため、現在のサーバでは許可されません。デバイスリストを消去して新しくペアリングするか、コントロールサーバを元に戻してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "저장된 기기 %1$@대는 다른 제어 서버(%2$@)에서 페어링해 지금 서버에서는 허용하지 않습니다. 기기 목록을 지우고 새로 페어링하거나, 제어 서버를 원래대로 되돌리세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已存储的 %1$@ 台设备是在其他控制服务器（%2$@）上配对的，当前服务器不允许使用。请清除设备列表后重新配对，或将控制服务器改回原来的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的 %1$@ 部裝置是在其他控制伺服器(%2$@)配對的，目前的伺服器不允許使用。請清除裝置列表後重新配對，或將控制伺服器改回原本的設定。"
          }
        }
      }
    },
    "저장된 기기 목록(%@)을 읽지 못했습니다: %@ 파일을 복구한 뒤 공유를 시작하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the saved device list (%1$@): %2$@ Repair the file, then start sharing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているデバイスリスト(%1$@)を読み込めませんでした: %2$@ ファイルを復旧してから共有を開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "저장된 기기 목록(%1$@)을 읽지 못했습니다: %2$@ 파일을 복구한 뒤 공유를 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已存储的设备列表（%1$@）：%2$@ 请修复该文件后开始共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的裝置列表(%1$@)：%2$@ 請修復檔案後再開始共享。"
          }
        }
      }
    },
    "저장된 빌드 목록(%@)을 읽지 못했습니다: %@ 게시한 빌드는 그대로 두었습니다. 파일을 복구한 뒤 공유를 시작하거나 빌드를 다시 가져오세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the saved build list (%1$@): %2$@ The published builds were left as they are. Repair the file, then start sharing or import the build again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているビルドリスト(%1$@)を読み込めませんでした: %2$@ 公開したビルドはそのまま残しています。ファイルを復旧してから共有を開始するか、ビルドをもう一度インポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "저장된 빌드 목록(%1$@)을 읽지 못했습니다: %2$@ 게시한 빌드는 그대로 두었습니다. 파일을 복구한 뒤 공유를 시작하거나 빌드를 다시 가져오세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已存储的构建列表（%1$@）：%2$@ 已发布的构建保持不变。请修复该文件后开始共享，或重新导入构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的建置列表(%1$@)：%2$@ 已發布的建置維持原樣。請修復檔案後開始共享，或重新匯入建置。"
          }
        }
      }
    },
    "저장된 빌드 목록을 읽지 못해 가져오지 않았습니다. 목록 파일을 복구한 뒤 다시 가져오세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read the saved build list, so nothing was imported. Repair the list file, then import again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されているビルドリストを読み込めなかったため、インポートしませんでした。リストファイルを復旧してから、もう一度インポートしてください。"
          }
