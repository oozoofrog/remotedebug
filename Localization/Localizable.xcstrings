        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒绝 %@ 的配对请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒絕 %@ 的配對要求。"
          }
        }
      }
    },
    "%@의 페어링 요청을 거부했습니다. 이미 허용한 기기라 기존 접근은 그대로입니다. 접근을 끊으려면 기기 목록에서 제거하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denied the pairing request from %@. This device was already allowed, so its existing access is unchanged. To cut off access, remove it from the device list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のペアリングリクエストを拒否しました。すでに許可済みのデバイスなので、既存のアクセスはそのままです。アクセスを解除するには、デバイス一覧から削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒绝 %@ 的配对请求。该设备已被允许，现有访问保持不变。要切断访问，请从设备列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒絕 %@ 的配對要求。此裝置先前已允許，因此原有的存取不受影響。若要中斷存取，請從裝置列表中移除。"
          }
        }
      }
    },
    "%@의 페어링 요청이 만료됐습니다. iPhone에서 다시 요청하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pairing request from %@ expired. Request again on iPhone."
          }
