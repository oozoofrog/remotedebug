    "Mac에서 빌드가 바뀌었습니다. 목록을 새로고침하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The build changed on the Mac. Refresh the list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac上でビルドが変更されました。一覧を再読み込みしてください。"
          }
