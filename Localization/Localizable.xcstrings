    "페이지에 아래 코드를 넣고 페어링을 요청한 뒤, 이 Mac에서 허용합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the code below on the page and request pairing, then allow it on this Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページに下のコードを入力してペアリングをリクエストし、このMacで許可します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
