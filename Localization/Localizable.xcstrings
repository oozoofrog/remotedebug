    "페어링한 Mac이 없습니다. RemoteDebug 앱에서 Mac과 페어링하면 여기에 RemoteDebug 빌드가 나옵니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No paired Mac. Pair with a Mac in the RemoteDebug app and RemoteDebug builds will appear here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした Mac がありません。RemoteDebug アプリで Mac とペアリングすると、ここに RemoteDebug ビルドが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已配对的 Mac。在 RemoteDebug App 中与 Mac 配对后，RemoteDebug 构建会显示在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
