    },
    "제어 서버가 바뀌어 %@ 기기를 허용 목록에 넣지 않았습니다. 지금 서버에서 다시 페어링하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The control server changed, so the device %@ wasn't added to the allowed list. Pair again on the current server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールサーバが変更されたため、デバイス %@ を許可リストに追加しませんでした。現在のサーバでもう一度ペアリングしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于控制服务器已更改，未将设备 %@ 加入允许列表。请在当前服务器上重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於控制伺服器已變更，未將裝置 %@ 加入允許列表。請在目前的伺服器上重新配對。"
          }
        }
      }
    },
    "제어 서버가 바뀌어 %@를 추가하지 않았습니다. 지금 서버에서 새 코드로 다시 페어링하세요." : {
