        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のペアリングリクエストは期限切れです。iPhoneからもう一度リクエストしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
