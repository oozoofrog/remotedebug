    },
    "앱 버전, iOS 버전과 함께 페어링한 Mac으로 갑니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent to the paired Mac along with the app version and iOS version."
          }
