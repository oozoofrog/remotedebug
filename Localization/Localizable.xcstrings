    },
    "iPhone에 닿지 못했습니다. 케이블로 연결하고 잠금을 푼 뒤 '이 컴퓨터를 신뢰'를 허용하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't reach the iPhone. Connect it with a cable, unlock it, and allow \"Trust This Computer\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに到達できませんでした。ケーブルで接続してロックを解除し、「このコンピュータを信頼」を許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 iPhone。请用线缆连接并解锁，然后允许“信任此电脑”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法連上 iPhone。請用傳輸線連接、解鎖，並允許「信任這部電腦」。"
          }
        }
      }
    },
    "iPhone에 설치" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install on iPhone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneにインストール"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装到 iPhone"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝到 iPhone"
          }
        }
      }
    },
    "iPhone에 설치하는 중…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing on iPhone…"
          }
        },
        "ja" : {
          "stringUnit" : {
