          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このQRコードには1回だけ使えるTailscaleキーが含まれているため、iPhoneはサインインせずに接続します。他人に見せないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
