    },
    "%@에 받은 목록. 설치하는 동안 RemoteDebug 앱이 닫힙니다. VPN이 이 앱의 터널이 아니면 이 앱으로 옮긴 뒤 설치합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded list on %@. The RemoteDebug app closes during installation. If VPN isn't this app's tunnel, it moves to this app before installing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に受信した一覧。インストール中はRemoteDebugアプリが閉じます。VPNがこのアプリのトンネルでない場合は、このアプリに切り替えてからインストールします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 收到的列表。安装期间 RemoteDebug App 会关闭。如果 VPN 不是此 App 的隧道，将先切换到此 App 再安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
