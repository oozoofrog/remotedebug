          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tailnet 的 MagicDNS 已关闭，无法生成安装地址。请在 Tailscale 管理控制台的 DNS 页面（%@）打开 MagicDNS 和 HTTPS Certificates。打开后无需重新开始共享，稍后安装地址就会生效。"
          }
