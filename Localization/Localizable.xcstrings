          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：匯入期間檔案已變更。請在建置完成後再次匯入。"
          }
        }
      }
    },
    "%@: 목록에 없는 빌드입니다." : {
