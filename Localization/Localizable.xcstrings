          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 VPN 连接"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待 VPN 連線"
          }
        }
      }
    },
    "VPN이 연결되면 %@에 페어링을 요청합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once VPN connects, it requests pairing with %@."
          }
        },
        "ja" : {
          "stringUnit" : {
