    "%@ %@ (%@): iPhone의 빌드 목록에서 빠지고, 진행 중인 설치는 끊깁니다. 원본 파일은 그대로 둡니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ (%3$@): It will be removed from the build list on iPhone, and any installation in progress will be interrupted. The original file is left as is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ (%3$@): iPhoneのビルド一覧から削除され、進行中のインストールは中断されます。元のファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ (%3$@): iPhone의 빌드 목록에서 빠지고, 진행 중인 설치는 끊깁니다. 원본 파일은 그대로 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@（%3$@）：将从 iPhone 的构建列表中移除，进行中的安装会中断。原始文件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ (%3$@)：會從 iPhone 的建置列表中移除，進行中的安裝也會中斷。原始檔案不受影響。"
          }
        }
      }
    },
