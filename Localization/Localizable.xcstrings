            "value" : "儲存在此 iPhone"
          }
        }
      }
    },
    "이 iPhone에 저장된 Tailscale 로그인을 지우고 VPN을 다시 켭니다. 로그인 페이지가 나오면 Mac과 같은 계정을 고르세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes the Tailscale login stored on this iPhone and turns the VPN back on. If a login page appears, choose the same account as the Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
