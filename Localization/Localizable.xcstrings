    "이 Mac 잊기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forget This Mac"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
