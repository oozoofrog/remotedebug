          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存。配對 QR 現在會包含一次性 Tailscale 金鑰(%@)，iPhone 不必登入即可連線。"
          }
        }
      }
