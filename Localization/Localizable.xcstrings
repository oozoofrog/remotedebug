        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: iPhoneのリンク一覧から削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：将从 iPhone 的链接列表中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：會從 iPhone 的連結列表中移除。"
          }
        }
      }
    },
    "%@: iPhone의 받을 파일 목록에서 빠집니다. iPhone에 이미 받은 사본과 Mac의 원본은 그대로 둡니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: It will be removed from the list of files to download on iPhone. The copy already downloaded to iPhone and the original on the Mac are left as is."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: iPhoneの受信ファイル一覧から削除されます。iPhoneにダウンロード済みのコピーとMac上の元のファイルはそのまま残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：将从 iPhone 的待下载文件列表中移除。iPhone 上已下载的副本和 Mac 上的原件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：會從 iPhone 的待接收檔案列表中移除。iPhone 上已接收的副本與 Mac 上的原始檔案不受影響。"
          }
        }
      }
    },
    "%@: 가져오는 동안 파일이 바뀌었습니다. 빌드가 끝난 뒤 다시 가져오세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: The file changed during import. Import again after the build finishes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 読み込み中にファイルが変更されました。ビルドが完了してから、もう一度読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
