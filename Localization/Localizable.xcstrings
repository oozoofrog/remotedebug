    "%lld:%@ 안에 허용하거나 거부하지 않으면 요청이 만료됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The request expires unless you allow or deny it within %1$lld:%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld:%2$@以内に許可または拒否しないと、リクエストは期限切れになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld:%2$@ 안에 허용하거나 거부하지 않으면 요청이 만료됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不在 %1$lld:%2$@ 内允许或拒绝，请求将过期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若未在 %1$lld:%2$@ 內允許或拒絕，要求將會過期。"
          }
        }
      }
    },
