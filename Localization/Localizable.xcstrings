    "Mac 앱과 통신 규약 버전이 다릅니다. iPhone 앱과 Mac 앱을 최신 버전으로 맞추세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The protocol version differs from the Mac app. Update both the iPhone app and the Mac app to the latest version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macアプリと通信プロトコルのバージョンが異なります。iPhoneアプリとMacアプリを最新バージョンにそろえてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 Mac App 的通信协议版本不同。请将 iPhone App 和 Mac App 更新到相同的最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
