    },
    "페어링한 Mac이 없습니다. RemoteDebug 앱에서 Mac과 페어링하면 여기에 RemoteDebug 빌드가 나옵니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No paired Mac. Pair with a Mac in the RemoteDebug app and RemoteDebug builds will appear here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした Mac がありません。RemoteDebug アプリで Mac とペアリングすると、ここに RemoteDebug ビルドが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有已配对的 Mac。在 RemoteDebug App 中与 Mac 配对后，RemoteDebug 构建会显示在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有已配對的 Mac。在 RemoteDebug App 中與 Mac 配對後，RemoteDebug 建置就會顯示在這裡。"
          }
        }
      }
    },
    "페어링한 iPhone에서 %@의 빌드를 설치할 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paired iPhone can install builds of %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした iPhone で %@ のビルドをインストールできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在已配对的 iPhone 上安装 %@ 的构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在已配對的 iPhone 上安裝 %@ 的建置。"
          }
        }
      }
    },
    "페어링한 iPhone에서 게시한 빌드를 설치할 수 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The paired iPhone can install published builds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした iPhone で、公開したビルドをインストールできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以在已配对的 iPhone 上安装已发布的构建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在已配對的 iPhone 上安裝已發布的建置。"
          }
        }
      }
    },
    "페어링한 iPhone의 RemoteDebug 앱이 VPN에 연결되면 빌드 목록을 받을 때마다 로그를 보냅니다. iPhone 앱의 설정 > 진단 로그에서 바로 보낼 수도 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the RemoteDebug app on the paired iPhone connects to the VPN, it sends logs each time it downloads the build list. You can also send them directly from Settings > Diagnostic Log in the iPhone app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした iPhone の RemoteDebug アプリが VPN に接続されると、ビルドリストを取得するたびにログを送信します。iPhone アプリの「設定」>「診断ログ」から直接送信することもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配对 iPhone 上的 RemoteDebug App 连接到 VPN 后，每次下载构建列表时都会发送日志。也可以直接在 iPhone App 的“设置”>“诊断日志”中发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配對 iPhone 的 RemoteDebug App 連上 VPN 後，每次下載建置列表都會傳送記錄。也可以直接從 iPhone App 的「設定」>「診斷記錄」傳送。"
          }
        }
      }
    },
    "페어링한 iPhone의 요청 받기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receive requests from the paired iPhone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングした iPhone のリクエストを受信"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收已配对 iPhone 的请求"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收已配對 iPhone 的請求"
          }
        }
      }
    },
    "페어링한 기기 %lld대는 지금 제어 서버에서 페어링해 새 서버에서는 쓸 수 없습니다. 바꾸면 기기 목록을 지우고, 새 서버에서 iPhone을 다시 페어링해야 합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld paired devices were paired on the current control server and can't be used on a new one. If you change it, the device list is cleared and you need to pair the iPhone again on the new server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングしたデバイス %lld 台は現在のコントロールサーバでペアリングされたため、新しいサーバでは使用できません。変更するとデバイスリストが消去され、新しいサーバで iPhone をもう一度ペアリングする必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 台已配对设备是在当前控制服务器上配对的，无法在新服务器上使用。更改后将清除设备列表，并需要在新服务器上重新配对 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已配對的 %lld 部裝置是在目前的控制伺服器配對的，新伺服器無法使用。變更後會清除裝置列表，必須在新伺服器上重新配對 iPhone。"
          }
        }
      }
    },
    "페어링한 기기 없음" : {
