    "앱 딥 링크는 그 스킴을 등록한 앱이 설치돼 있어야 열립니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An app deep link opens only if an app that registered that scheme is installed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのディープリンクは、そのスキームを登録しているアプリがインストールされている場合に開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
