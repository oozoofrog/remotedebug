          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't save the pairing info. You'll need to pair again when you reopen the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリング情報を保存できませんでした。アプリを再び開くと、もう一度ペアリングが必要になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
