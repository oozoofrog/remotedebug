        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的建置列表，因此未匯入。請修復列表檔案後再重新匯入。"
          }
        }
      }
    },
    "저장한 감시 폴더를 열 수 없습니다. 폴더를 다시 고르세요." : {
      "localizations" : {
        "en" : {
