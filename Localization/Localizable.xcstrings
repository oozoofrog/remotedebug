    "%@: 확인한 뒤 내용이 바뀌어 가져오지 않았습니다. 다시 가져와 새 내용을 확인하세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: The contents changed after checking, so it wasn't imported. Import it again and check the new contents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 確認後に内容が変更されたため、読み込みませんでした。もう一度読み込んで、新しい内容を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
