    },
    "페어링 QR을 iPhone 앱으로 찍은 뒤, 이 Mac에 온 요청을 허용합니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the pairing QR with the iPhone app, then allow the request on this Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングQRをiPhoneアプリで読み取ってから、このMacに届いたリクエストを許可します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 iPhone App 扫描配对二维码，然后在这台 Mac 上允许收到的请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 iPhone App 掃描配對 QR 碼，然後在這台 Mac 上允許收到的請求。"
          }
        }
      }
    },
    "페어링 QR을 만들지 못했습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't create the pairing QR code."
