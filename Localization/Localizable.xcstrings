          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 QR 碼包含只能使用一次的 Tailscale 金鑰，因此 iPhone 無需登入即可連線。請勿向他人展示。"
          }
        }
