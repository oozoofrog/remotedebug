    "consent.explanation" : {
      "comment" : "Message of the consent alert. %1$lld is how many lines are kept, %2$@ the name of the switch that attaches logs, %3$@ the number of minutes of system logs.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The app keeps a record of its activity (screen changes, errors, times), up to the most recent %1$lld line, in this device's memory. The record is gone when the app quits. Only when you turn on “%2$@” while sending feedback are this record and this app's system logs from the last %3$@ minutes encrypted and sent to the developer. What you send is used only to look into the problem, and turning this switch off deletes the record left on the device."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The app keeps a record of its activity (screen changes, errors, times), up to the most recent %1$lld lines, in this device's memory. The record is gone when the app quits. Only when you turn on “%2$@” while sending feedback are this record and this app's system logs from the last %3$@ minutes encrypted and sent to the developer. What you send is used only to look into the problem, and turning this switch off deletes the record left on the device."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの動作記録（画面の移動、エラー、時刻）を最新の%1$lld行までこのデバイスのメモリに保持し、アプリを終了すると消えます。フィードバックを送るときに「%2$@」をオンにした場合にのみ、この記録とこのアプリの直近%3$@分間のシステムログを暗号化して開発者に送信します。送信した記録は問題の調査にのみ使用し、このスイッチをオフにするとデバイスに残っている記録を削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 남기는 동작 기록(화면 이동, 오류, 시각)을 최근 %1$lld줄까지 이 기기의 메모리에 두고, 앱을 끄면 사라집니다. 피드백을 보낼 때 \"%2$@\"를 켠 경우에만 이 기록과 이 앱의 최근 %3$@분 시스템 로그를 암호화해서 개발자에게 보냅니다. 보낸 기록은 문제를 살펴보는 데만 쓰고, 이 스위치를 끄면 기기에 남은 기록을 지웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的运行记录（页面切换、错误、时间）最多保留最近 %1$lld 行，存放在本设备的内存中，退出 App 后即消失。仅当你在发送反馈时打开“%2$@”，才会将此记录和此 App 最近 %3$@ 分钟的系统日志加密后发送给开发者。发送的记录仅用于排查问题；关闭此开关会删除设备上保留的记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 的運作記錄（畫面切換、錯誤、時間）最多保留最近 %1$lld 行，存放在本裝置的記憶體中，結束 App 後即消失。僅當你在傳送意見回饋時開啟「%2$@」，才會將此記錄和此 App 最近 %3$@ 分鐘的系統日誌加密後傳送給開發者。傳送的記錄僅用於調查問題；關閉此開關會刪除裝置上保留的記錄。"
          }
        }
      }
    },
    "consent.footer" : {
      "comment" : "Footer under the log recording switch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this is on, the app keeps a record of its recent activity on this device, and you can choose whether to attach it when you send feedback. Turning it off deletes the record right away."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、このアプリの最近の動作記録をこのデバイスに残し、フィードバックを送るときに添付するかどうかを選べます。オフにすると、残した記録をすぐに削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 이 앱의 최근 동작 기록을 이 기기에 남기고, 피드백을 보낼 때 붙일지 고를 수 있습니다. 끄면 남긴 기록을 바로 지웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开后，此 App 会在本设备上保留最近的运行记录，发送反馈时可选择是否附加。关闭后会立即删除已保留的记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，此 App 會在本裝置上保留最近的運作記錄，傳送意見回饋時可選擇是否附加。關閉後會立即刪除已保留的記錄。"
          }
        }
      }
    },
