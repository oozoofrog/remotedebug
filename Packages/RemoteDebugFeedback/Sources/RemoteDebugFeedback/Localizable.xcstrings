          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진과 파일을 %1$lld개까지 붙일 수 있습니다. 파일 하나는 %2$@MB, 모두 합쳐 %3$@MB까지이고 사진은 크기를 줄여 붙입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可附加 %1$lld 个照片和文件。单个文件不超过 %2$@ MB，总计不超过 %3$@ MB，照片会缩小后附加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可附加 %1$lld 個照片和檔案。單一檔案不超過 %2$@ MB，總計不超過 %3$@ MB，照片會縮小後附加。"
          }
        }
      }
